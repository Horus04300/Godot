extends RefCounted
## Owner-authorized reference cutouts, generated by tools/prepare_reference_art.py.
## Masters retain source resolution; hero cells 1024x1024, foot (512,990).
## Floor source 128x64, display 55.04x27.52. Props are bottom-center anchored.
## Variant 0..5 grass, 6..11 stone; add 12/24/36 for extra sample banks.
## Fourth source pose retained; tiny overprinted sword tip uses clean source sword pixels.
## Motion is restrained cutout translation, not a claim of original attack frames.

const BASE := "res://assets/reference/"
const OLD_ART = preload("res://scripts/sanctuary_art.gd")
const TILE_DISPLAY := Vector2(55.04, 27.52)
const HERO_CELL := Vector2(1024, 1024)
const HERO_FOOT := Vector2(512, 990)
const HERO_HEIGHT := 80.0
const PROP_HEIGHT := {
	"tree": 135.0, "rock": 22.0, "bush": 47.0, "mushroom": 34.0,
	"roots": 52.0, "pillar": 113.0, "gate": 120.0, "chest": 39.0, "urn": 37.0,
}
const ALIASES := {
	"column": "pillar", "pillar_broken": "rock", "ruin": "rock",
	"arch": "gate", "mushrooms": "mushroom", "thorn": "roots",
}

static func _load_texture(path: String) -> Texture2D:
	var image_texture := load(path) as Texture2D
	if image_texture == null:
		push_error("Reference artwork missing or invalid: " + path + ". Run tools/prepare_reference_art.py and import the PNGs.")
		return null
	var texture := CanvasTexture.new()
	texture.diffuse_texture = image_texture
	texture.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	return texture

static func load_assets() -> Dictionary:
	var assets: Dictionary = {}
	for key: String in ["terrain", "hero_front", "hero_back", "hero_left", "hero_right", "tree", "tree_1", "tree_2", "rock", "bush", "bush_1", "bush_2", "mushroom", "roots", "pillar", "gate", "chest", "urn"]:
		assets[key] = _load_texture(BASE + key + ".png")
	assets["hero_heights"] = {}
	for pose: String in ["front", "back", "left", "right"]:
		var texture := assets["hero_" + pose] as CanvasTexture
		if texture != null:
			assets["hero_heights"][pose] = float(texture.diffuse_texture.get_image().get_used_rect().size.y)
	# Only sanctioned legacy water/bridge terrain and crate are reused.
	assets["old_terrain"] = _load_texture("res://assets/sanctuary/terrain.png")
	assets["old_props"] = _load_texture("res://assets/sanctuary/props.png")
	return assets

static func _texture(assets: Dictionary, key: String) -> Texture2D:
	var texture: Texture2D = assets.get(key) as Texture2D
	if texture == null:
		push_error("Reference artwork texture unavailable: " + key)
	return texture

static func floor(canvas: CanvasItem, assets: Dictionary, pos_screen: Vector2, variant: int, water: bool = false, bridge: bool = false, time: float = 0.0) -> void:
	if water or bridge:
		OLD_ART.floor(canvas, {"terrain": _texture(assets, "old_terrain")}, pos_screen, variant, water, bridge, time)
		return
	var texture := _texture(assets, "terrain")
	if texture == null:
		return
	var selection := posmod(variant, 48)
	var sample_index := selection % 6 + int(selection / 12.0) * 6
	if selection % 12 >= 6:
		sample_index += 24
	var cell := Vector2(sample_index % 8, floorf(float(sample_index) / 8.0))
	canvas.draw_texture_rect_region(texture, Rect2(pos_screen - TILE_DISPLAY * 0.5, TILE_DISPLAY),
		Rect2(cell * Vector2(128, 64), Vector2(128, 64)), Color.WHITE, false, true)

static func prop(canvas: CanvasItem, assets: Dictionary, kind: String, screenpos: Vector2, variant: int = 0, alpha: float = 1.0) -> void:
	if kind == "crate":
		OLD_ART.prop(canvas, {"props": _texture(assets, "old_props")}, kind, screenpos, variant, alpha)
		return
	var key: String = ALIASES.get(kind, kind)
	if not PROP_HEIGHT.has(key):
		push_error("Unknown reference prop: " + kind)
		return
	var texture_key := key
	if key in ["tree", "bush"] and posmod(variant, 3) != 0:
		texture_key += "_" + str(posmod(variant, 3))
	var texture := _texture(assets, texture_key)
	if texture == null:
		return
	var source_size := texture.get_size()
	var height: float = PROP_HEIGHT[key]
	var size := source_size * (height / source_size.y)
	var offset := Vector2.ZERO
	var mirror := false
	if key == "tree":
		size.x = 125.0
		mirror = posmod(variant, 2) == 1
	elif key == "bush":
		size = Vector2(54.0 + posmod(variant * 7, 9), 35.0 + posmod(variant * 11, 13))
		offset = Vector2(posmod(variant * 13, 9) - 4, posmod(variant * 7, 7) - 3)
		mirror = posmod(variant, 2) == 1
	var rect := Rect2(screenpos + offset - Vector2(size.x * 0.5, size.y), size)
	if mirror:
		rect.position.x += size.x
		rect.size.x = -size.x
	canvas.draw_texture_rect(texture, rect,
		false, Color(1, 1, 1, clampf(alpha, 0, 1)))

static func hero(canvas: CanvasItem, assets: Dictionary, screenpos: Vector2, direction: Vector2, phase: float, flash: bool = false, alpha: float = 1.0, action_frame: int = -1) -> void:
	# Source labels describe views, not head-facing screen directions.
	var pose := "right" if direction.x < 0 else "front"
	if direction.y < -absf(direction.x) * 0.35:
		pose = "left" if direction.x < 0 else "back"
	var texture := _texture(assets, "hero_" + pose)
	if texture == null:
		return
	var source_height: float = assets["hero_heights"][pose]
	var display_scale := HERO_HEIGHT / source_height
	var motion := Vector2.ZERO
	if not is_zero_approx(phase):
		motion = Vector2(sin(phase) * 0.6, -absf(sin(phase * 2.0)) * 0.8)
	if action_frame >= 0:
		motion += direction.normalized() * [0.0, 2.0, 0.5][posmod(action_frame, 3)]
	var tint := Color(1.7, 1.6, 1.4, clampf(alpha, 0, 1)) if flash else Color(1, 1, 1, clampf(alpha, 0, 1))
	canvas.draw_texture_rect(texture, Rect2(screenpos + motion - HERO_FOOT * display_scale, HERO_CELL * display_scale), false, tint)
